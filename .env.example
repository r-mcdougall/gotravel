# Copy to .env and adjust: cp .env.example .env
# Values below are for local development only.

# PostgreSQL superuser (used only by the container and for admin tasks)
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres-dev-password
# Host port for local tooling (psql, sqlc, goose)
POSTGRES_PORT=5432

# Per-service database passwords (roles: auth_svc, catalog_svc, booking_svc, payment_svc)
AUTH_DB_PASSWORD=auth-dev-password
CATALOG_DB_PASSWORD=catalog-dev-password
BOOKING_DB_PASSWORD=booking-dev-password
PAYMENT_DB_PASSWORD=payment-dev-password
