# Copy to .env and adjust: cp .env.example .env
# Values below are for local development only.

# Host port of the API gateway (nginx)
GATEWAY_PORT=8080

# PostgreSQL superuser (used only by the container and for admin tasks)
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres-dev-password
# Host port for local tooling (psql, sqlc, goose)
POSTGRES_PORT=5432

# Host port of Redis (cache)
REDIS_PORT=6379

# Host port of Prometheus
PROMETHEUS_PORT=9090

# Grafana admin login and host port
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=grafana-dev-password
GRAFANA_PORT=3000

# RabbitMQ credentials and host ports (AMQP and management UI)
RABBITMQ_USER=gotravel
RABBITMQ_PASSWORD=rabbitmq-dev-password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Per-service database passwords (roles: auth_svc, catalog_svc, booking_svc, payment_svc)
AUTH_DB_PASSWORD=auth-dev-password
CATALOG_DB_PASSWORD=catalog-dev-password
BOOKING_DB_PASSWORD=booking-dev-password
PAYMENT_DB_PASSWORD=payment-dev-password

# First admin account, created by the auth service on start if it does not exist.
# Leave both empty to skip. The password is not changed on later starts.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin-dev-password

# Search cache. Leave unset to use Redis; set to empty to run catalog without it.
# CATALOG_REDIS_URL=
# SEARCH_CACHE_TTL=60s

# How long a booking holds its seats before it expires. Shorten it (e.g. 1m)
# to watch holds expire during manual tests.
# HOLD_TTL=15m
