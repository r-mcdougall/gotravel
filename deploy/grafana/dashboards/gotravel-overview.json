      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum by (job) (rate(http_requests_total{job=~\"$service\", status=~\"5..\"}[$__rate_interval])) or sum by (job) (rate(http_requests_total{job=~\"$service\"}[$__rate_interval])) * 0) / sum by (job) (rate(http_requests_total{job=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "axisSoftMax": 0.05
